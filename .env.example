# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=regula-platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── Database (Postgres + pgvector) ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://regula:regula@postgres:5432/regula
DATABASE_POOL_SIZE=10

# ── Redis (rate limit, Celery broker, cache) ───────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Object Storage (MinIO local / GCP Storage prod) ──────────────────────────
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=regula-documents

# ── Auth (RS256 JWT) ───────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI — Gemini primary, Groq fallback ───────────────────────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY=gemini-2.0-flash
LLM_FALLBACK=llama-3.3-70b-versatile
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# ── External integrations ──────────────────────────────────────────────────────
TAVILY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=

# ── Frontend ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
VITE_API_URL=http://localhost:8000
